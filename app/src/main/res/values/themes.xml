<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.ILutoMo" parent="Theme.Material3.DayNight.NoActionBar">
    </style>

    <style name="Theme.ILutoMo" parent="Base.Theme.ILutoMo" />

    <style name="CircleImage"><item name="cornerSize">50%</item></style>

    <style name="InventoryCircle">
        <item name="android:layout_width">75dp</item>
        <item name="android:layout_height">75dp</item>
        <item name="android:background">@drawable/circle_background_grey</item>
    </style>

    <style name="OrderStatusTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">8dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#1B3022</item>
        <item name="android:background">@drawable/button_outline</item>
    </style>

    <style name="ManageItemRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">55dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/button_outline</item>
    </style>

    <style name="ManageItemText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#1B3022</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ManageItemArrow">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:src">@android:drawable/ic_media_play</item>
        <item name="android:tint">#1B3022</item>
    </style>
</resources>