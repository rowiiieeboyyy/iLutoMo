<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="What's in your fridge?"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#2D5A27"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add ingredients you have, and we'll find the best matches."
        android:textSize="13sp"
        android:textColor="#777777"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilIngredient"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:endIconMode="custom"
        app:endIconDrawable="@android:drawable/ic_input_add"
        app:endIconTint="#2D5A27">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etIngredientInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Type ingredient (e.g. Chicken)"
            android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cgIngredients"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:chipSpacing="8dp" />
</LinearLayout>