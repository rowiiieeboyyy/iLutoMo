<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <RelativeLayout
        android:id="@+id/order_top_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/order_back_arrow"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_revert"
            android:padding="4dp"
            app:tint="#000000" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/order_back_arrow"
            android:text="Order Tracking"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/order_top_bar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order Summary"
                android:textColor="#2E5A27"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llOrderItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Order Status : Pending"
                android:textColor="#2E5A27"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <ImageView
                    android:id="@+id/order_loc_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    android:padding="4dp"
                    android:background="#F0F0F0"/>
                <TextView
                    android:id="@+id/order_loc_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/order_loc_icon"
                    android:layout_marginStart="8dp"
                    android:text="Pickup Location"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvPickupAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/order_loc_label"
                    android:layout_toEndOf="@id/order_loc_icon"
                    android:layout_marginStart="8dp"
                    android:text="Loading..."
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvPickupTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:gravity="end"
                    android:text="Set Pickup Time"
                    android:textColor="#2E7D32"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackground"/>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <ImageView
                    android:id="@+id/order_time_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:padding="4dp"
                    android:background="#F0F0F0"/>
                <TextView
                    android:id="@+id/order_time_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/order_time_icon"
                    android:layout_marginStart="8dp"
                    android:text="Expected Ready Time"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvExpectedReadyTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/order_time_label"
                    android:layout_toEndOf="@id/order_time_icon"
                    android:layout_marginStart="8dp"
                    android:text="Approximately 30 mins"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"/>
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/order_btn_place_order"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Place Order"
                    android:backgroundTint="#2E7D32"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCancelOrder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Cancel Order"
                    android:textAllCaps="false"
                    android:backgroundTint="#D32F2F"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="4dp"
                    android:visibility="visible"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>