<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/headerMacros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#1B3022" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Macros"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1B3022"
            android:layout_marginStart="10dp" />

        <ImageView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/my_profile"
            android:scaleType="centerCrop" />
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#888888"
        app:layout_constraintTop_toBottomOf="@id/headerMacros" />

    <androidx.cardview.widget.CardView
        android:id="@+id/macrosCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#D3D3D3"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Selected Recipe:" android:textStyle="bold" android:textColor="#1B3022" android:textSize="18sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pork Adobo" android:layout_alignParentEnd="true" android:textStyle="bold" android:textColor="#1B3022" android:textSize="18sp"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Grams (Per Serving):" android:textStyle="bold" android:textColor="#1B3022" android:textSize="17sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="520 kcal" android:layout_alignParentEnd="true" android:textStyle="bold" android:textColor="#1B3022" android:textSize="17sp"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calories:" android:textStyle="bold" android:textColor="#1B3022" android:textSize="17sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="27 g" android:layout_alignParentEnd="true" android:textStyle="bold" android:textColor="#1B3022" android:textSize="17sp"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Protein:" android:textStyle="bold" android:textColor="#1B3022" android:textSize="17sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="45 g" android:layout_alignParentEnd="true" android:textStyle="bold" android:textColor="#1B3022" android:textSize="17sp"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fats:" android:textStyle="bold" android:textColor="#1B3022" android:textSize="17sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1,600" android:layout_alignParentEnd="true" android:textStyle="bold" android:textColor="#1B3022" android:textSize="17sp"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sodium:" android:textStyle="bold" android:textColor="#1B3022" android:textSize="17sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="mg" android:layout_alignParentEnd="true" android:textStyle="bold" android:textColor="#1B3022" android:textSize="17sp"/>
            </RelativeLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sugar:" android:textStyle="bold" android:textColor="#1B3022" android:textSize="17sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 g" android:layout_alignParentEnd="true" android:textStyle="bold" android:textColor="#1B3022" android:textSize="17sp"/>
            </RelativeLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#FFFFFF"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>