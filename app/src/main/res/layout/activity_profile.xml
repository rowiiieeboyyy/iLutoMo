<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="Profile &amp; Preferences"
        android:textColor="#2D5A27"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivProfile"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="15dp"
        android:src="@drawable/my_profile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/dividerHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#EEEEEE"
        app:layout_constraintTop_toBottomOf="@id/ivProfile" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="10dp"
        app:layout_constraintBottom_toTopOf="@id/btnSave"
        app:layout_constraintTop_toBottomOf="@id/dividerHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dietary Type" android:textColor="#2D5A27" android:textStyle="bold" />
                        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2">
                            <CheckBox android:id="@+id/cbStandard" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Standard" android:textSize="11sp"/>
                            <CheckBox android:id="@+id/cbVegetarian" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vegetarian" android:textSize="11sp"/>
                            <CheckBox android:id="@+id/cbKeto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Keto" android:textSize="11sp"/>
                            <CheckBox android:id="@+id/cbPescatarian" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pescatarian" android:textSize="11sp"/>
                        </GridLayout>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Allergens" android:textColor="#2D5A27" android:textStyle="bold" />
                        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2">
                            <CheckBox android:id="@+id/cbSoy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Soy" android:textSize="11sp"/>
                            <CheckBox android:id="@+id/cbGluten" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gluten" android:textSize="11sp"/>
                            <CheckBox android:id="@+id/cbDairy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dairy" android:textSize="11sp"/>
                            <CheckBox android:id="@+id/cbOthers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Others" android:textSize="11sp"/>
                        </GridLayout>

                        <EditText android:id="@+id/etOtherAllergen" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:hint="Specify others..." android:textSize="12sp" android:visibility="gone" android:background="@android:drawable/editbox_background_normal" android:padding="8dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <CheckBox android:id="@+id/checkBudget" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Budget ₱" android:textSize="12sp" android:textColor="#2D5A27" />
                            <EditText android:id="@+id/etBudgetInput" android:layout_width="60dp" android:layout_height="wrap_content" android:inputType="number" android:textSize="12sp" android:hint="0" android:textAlignment="center" android:visibility="gone" />
                        </LinearLayout>
                        <com.google.android.material.slider.RangeSlider
                            android:id="@+id/rangeBudget"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:valueFrom="0" android:valueTo="1000"
                            app:values="@array/initial_range_values" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <CheckBox android:id="@+id/checkProtein" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Protein (g)" android:textSize="12sp" android:textColor="#2D5A27" />
                            <EditText android:id="@+id/etProteinInput" android:layout_width="60dp" android:layout_height="wrap_content" android:inputType="number" android:textSize="12sp" android:hint="0" android:textAlignment="center" android:visibility="gone" />
                        </LinearLayout>
                        <com.google.android.material.slider.RangeSlider
                            android:id="@+id/rangeProtein"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:valueFrom="0" android:valueTo="1000"
                            app:values="@array/initial_range_values" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <CheckBox android:id="@+id/checkCarbs" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Carbs (Max g)" android:textSize="12sp" android:textColor="#2D5A27" />
                            <EditText android:id="@+id/etCarbsInput" android:layout_width="60dp" android:layout_height="wrap_content" android:inputType="number" android:textSize="12sp" android:hint="0" android:textAlignment="center" android:visibility="gone" />
                        </LinearLayout>
                        <com.google.android.material.slider.Slider
                            android:id="@+id/rangeCarbs"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:valueFrom="0" android:valueTo="1000"
                            android:value="1000" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <CheckBox android:id="@+id/checkSugar" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Sugar (Max g)" android:textSize="12sp" android:textColor="#2D5A27" />
                            <EditText android:id="@+id/etSugarInput" android:layout_width="60dp" android:layout_height="wrap_content" android:inputType="number" android:textSize="12sp" android:hint="0" android:textAlignment="center" android:visibility="gone" />
                        </LinearLayout>
                        <com.google.android.material.slider.Slider
                            android:id="@+id/rangeSugar"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:valueFrom="0" android:valueTo="1000"
                            android:value="1000" />

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <CheckBox android:id="@+id/checkCalories" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Calories (Max kcal)" android:textSize="12sp" android:textColor="#2D5A27" />
                            <EditText android:id="@+id/etCaloriesInput" android:layout_width="60dp" android:layout_height="wrap_content" android:inputType="number" android:textSize="12sp" android:hint="0" android:textAlignment="center" android:visibility="gone" />
                        </LinearLayout>
                        <com.google.android.material.slider.Slider
                            android:id="@+id/rangeCalories"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:valueFrom="0" android:valueTo="10000"
                            android:value="10000" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="0.8"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#2D5A27"
                    app:cardCornerRadius="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="15dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Summary" android:textColor="#FFFFFF" android:textStyle="bold" />
                        <TextView android:id="@+id/tvSummaryDiet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Diet: Standard" android:textColor="#FFFFFF" android:textSize="11sp" />
                        <TextView android:id="@+id/tvSummaryAllergens" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Allergens: None" android:textColor="#FFFFFF" android:textSize="11sp" />
                        <TextView android:id="@+id/tvSummaryBudget" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Budget: ₱0" android:textColor="#FFFFFF" android:textSize="11sp" />
                        <TextView android:id="@+id/tvSummaryProtein" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Protein: 0g" android:textColor="#FFFFFF" android:textSize="11sp" />
                        <TextView android:id="@+id/tvSummaryCarbs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Carbs: Max 0g" android:textColor="#FFFFFF" android:textSize="11sp" />
                        <TextView android:id="@+id/tvSummarySugar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sugar: Max 0g" android:textColor="#FFFFFF" android:textSize="11sp" />
                        <TextView android:id="@+id/tvSummaryCalories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calories: Max 0kcal" android:textColor="#FFFFFF" android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewDiary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:backgroundTint="#FFFFFF"
                    android:text="Diary" android:textAllCaps="false" android:textColor="#2D5A27"
                    app:strokeColor="#2D5A27" app:strokeWidth="1dp" app:cornerRadius="15dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewOrders"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:backgroundTint="#FFFFFF"
                    android:text="Orders" android:textAllCaps="false" android:textColor="#2D5A27"
                    app:strokeColor="#2D5A27" app:strokeWidth="1dp" app:cornerRadius="15dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewManual"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:backgroundTint="#FFFFFF"
                    android:text="Users Manual" android:textAllCaps="false" android:textColor="#2D5A27"
                    app:strokeColor="#2D5A27" app:strokeWidth="1dp" app:cornerRadius="15dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp"
        android:backgroundTint="#2D2D2D"
        android:text="Save"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>